[
  {
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,
    "modules-left": ["custom/workspace"],
    "modules-center": [],
    "modules-right": [
      "custom/separator",
      "custom/cpu",
      "memory",
      "custom/calendar",
      "custom/pulseaudio",
      "network#wired",
      "network#wireless",
      "battery",
      "custom/notification"
    ],
    "custom/workspace": {
      "exec": "~/.config/waybar/scripts/workspaces.py eDP-1",
      "return-type": "json",
      "restart-interval": 5,
      "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
      "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'"
    },
    "include": ["~/.config/waybar/modules.json"]
  },
