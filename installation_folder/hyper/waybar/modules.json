{
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu-mode-class.sh",
    "on-click": "~/.config/waybar/scripts/cpu-mode-class.sh toggle",
    "return-type": "json",
    "interval": 4
  },
  "custom/calendar": {
    "exec": "~/.config/waybar/scripts/date.sh",
    "interval": 30,
    "on-click": "~/.config/waybar/scripts/calendar.sh curr",
    "on-scroll-up": "~/.config/waybar/scripts/calendar.sh next",
    "on-scroll-down": "~/.config/waybar/scripts/calendar.sh prev"
  },
  "memory": {
    "format": " {used:0.1f}G / {total:0.1f}G",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "RAM:   {used:0.2f}G / {total:0.2f}G  ({percentage}%)\nLibre: {avail:0.2f}G\n\nSwap:  {swapUsed:0.2f}G / {swapTotal:0.2f}G  ({swapPercentage}%)\nSwap libre: {swapAvail:0.2f}G",
    "on-click": "kitty btop"
  },
  "network#wired": {
    "interface": "enp1s0f1",
    "format": "󰀟 {ipaddr}",
    "format-disconnected": "",
    "tooltip-format-ethernet": "󰈀 {ifname}\nIP:      {ipaddr}/{cidr}\nGateway: {gwaddr}\nMáscara: {netmask}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Ethernet desconectado",
    "on-click": "kitty gazelle"
  },
  "network#wireless": {
    "interface": "wlp2s0",
    "format-wifi": "{icon} {essid}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤨"],
    "format-disconnected": "",
    "tooltip-format-wifi": "{icon}  {essid}\nSeñal:   {signalStrength}%  ({signaldBm} dBm)\nCalidad: {signalStrengthApp}\nFreq:    {frequency} GHz\nIP:      {ipaddr}/{cidr}\nGateway: {gwaddr}\nBSSID:   {bssid}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "WiFi desconectado",
    "on-click": "kitty gazelle"
  },
  "custom/pulseaudio": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/pavolume.sh --listen",
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/waybar/scripts/pavolume.sh --togmute",
    "on-scroll-up": "~/.config/waybar/scripts/pavolume.sh --up",
    "on-scroll-down": "~/.config/waybar/scripts/pavolume.sh --down",
    "tooltip": true,
    "escape": true
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-time": "{H}h {M}min",
    "tooltip": true,
    "tooltip-format": "Batería: {capacity}%\nEstado:  {timeTo}\nPotencia: {power} W\nSalud:   {health}%\nCiclos:  {cycles}",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/separator": {
    "format": ""
  },
  "tray": {
    "spacing": 12
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
